<Window x:Class="Cafebook.Views.Common.PhieuLuongPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước Phiếu Lương" Height="650" Width="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="ToolWindow" FontFamily="Segoe UI" FontSize="14"
        Background="White">

    <Grid x:Name="printArea" Background="White">
        <DockPanel Margin="25">
            <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="CAFEBOOK" FontSize="26" FontWeight="Bold" />
                <TextBlock x:Name="lblDiaChi" Text="Địa chỉ: ..." FontSize="12" Foreground="Gray"/>
                <TextBlock x:Name="lblSdt" Text="SĐT: ..." FontSize="12" Foreground="Gray"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="THỰC LÃNH" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="1" Text="{Binding ThucLanh, StringFormat='{}{0:N0} đ'}" FontSize="22" FontWeight="Bold" Foreground="#D35400" Margin="10,0,0,0"/>
                </Grid>
                <TextBlock Text="(Đã bao gồm các khoản thưởng và khấu trừ)" FontSize="11" FontStyle="Italic" HorizontalAlignment="Center" Foreground="Gray" Margin="0,5,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnPrint" Content="In Phiếu" Width="120" Height="40" Margin="5" Click="BtnPrint_Click"/>
                    <Button x:Name="btnClose" Content="Đóng" Width="120" Height="40" Margin="5" Click="BtnClose_Click" IsCancel="True"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="PHIẾU THANH TOÁN LƯƠNG" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhân viên:" FontWeight="SemiBold" Margin="0,2,10,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblNhanVien" TextAlignment="Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kỳ lương:" FontWeight="SemiBold" Margin="0,2,10,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblKyLuong" TextAlignment="Right"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ngày chốt:" FontWeight="SemiBold" Margin="0,2,10,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NgayTinhLuong, StringFormat='dd/MM/yyyy HH:mm'}" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,15,0,10" Padding="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="A. Lương chính" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid Margin="15,0,5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="- Tổng giờ làm" Foreground="Gray"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TongGioLam, StringFormat='{}{0:N2} giờ'}" Foreground="Gray"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="- Lương cơ bản" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LuongCoBan, StringFormat='{}{0:N0} đ'}" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="B. Các khoản thưởng" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding CacKhoanThuong}" Margin="15,0,5,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NoiDung, StringFormat='- {0}'}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SoTien, StringFormat='+ {0:N0} đ'}" Foreground="Green"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="C. Các khoản phạt" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding CacKhoanPhat}" Margin="15,0,5,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NoiDung, StringFormat='- {0}'}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SoTien, StringFormat='- {0:N0} đ'}" Foreground="Red"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>